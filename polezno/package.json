{
  "name": "polezno-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "demo": "node scripts/demo.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "import": "node --env-file-if-exists=.env scripts/import.ts",
    "check:llm": "node --env-file-if-exists=.env scripts/check-llm.ts",
    "check:load": "node scripts/check-load.ts",
    "check:readiness": "node --env-file-if-exists=.env scripts/check-readiness.ts",
    "evaluate": "node --env-file-if-exists=.env scripts/evaluate.ts",
    "setup:telegram": "node --env-file-if-exists=.env scripts/setup-telegram.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "backup:daily": "node --env-file-if-exists=.env scripts/backup-daily.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
